


import pandas as pd
import glob
import os

directorio_actual = os.getcwd()
nombre_dataset = "CIC18"
directorio_dataset = os.path.abspath(
    os.path.join(directorio_actual, "../../02_datasets/raw", nombre_dataset)
)

archivos = glob.glob(directorio_dataset + "/*.csv")
archivos.sort()

df_list = []

for archivo in archivos:
    print(f"Leyendo: {archivo}")
    df_temp = pd.read_csv(archivo, low_memory=False)
    df_list.append(df_temp)

df = pd.concat(df_list, ignore_index=True)





df.info()





df.head()





df[" Label"].value_counts()


df.shape


df.dtypes


df[" Label"].value_counts(normalize=True)


################## COLUMNAS CON VALORES ÚNICOS #####################
df.nunique().sort_values().head(20)


################## COLUMNAS CON ALTA CORRELACIÓN #####################
import numpy as np

df_datos = df.drop(columns = " Label")

corr_matrix = df_datos.corr().abs()


# Triangular superior

high_corr = (
    corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
    .stack()
    .sort_values(ascending=False)
)

high_corr[high_corr > 0.95].shape


#################### FILAS CON VALORES INFINITO, VACÍO Y NULO ###################
# Filas con valores nulos
df[df.isnull().any(axis=1)].shape


# Filas con valores infinito
df_datos[np.isinf(df_datos).any(axis=1)].shape



